# ===================================
# ระบบยืมคืนหนังสือ - Environment Configuration
# ===================================
# คัดลอกไฟล์นี้เป็น .env และแก้ไขค่าตามต้องการ
# cp .env.example .env

# -----------------------------------
# Database Configuration
# -----------------------------------
DB_HOST=localhost
DB_NAME=book_borrowing
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# -----------------------------------
# Application Settings
# -----------------------------------
APP_NAME="ระบบยืมคืนหนังสือ"
APP_URL=http://localhost/book_borrowing
ADMIN_EMAIL=admin@library.com

# -----------------------------------
# Borrow Settings (กฎการยืม)
# -----------------------------------
# 🔴 ปกติ "ไม่ต้องแก้ตรงนี้" — กฎการยืม-คืนตั้งได้ที่หน้าตั้งค่าระบบแล้ว
#    (เข้าเป็นผู้ดูแล → ตั้งค่าระบบ → ฟอร์ม "กฎการยืม-คืน")
#
#    ระบบอ่านค่าเรียง 3 ชั้น: หน้าตั้งค่า → ไฟล์นี้ → ค่าติดตัวโปรแกรม
#    พอกดบันทึกในหน้าตั้งค่าครั้งแรก ค่าในไฟล์นี้จะไม่มีผลอีกเลย
#    ค่าข้างล่างจึงเป็นแค่ "ค่าตั้งต้นตอนยังไม่เคยเข้าไปตั้งในหน้าเว็บ"

# จำนวนวันที่ยืมได้ (default)
DEFAULT_BORROW_DAYS=7

# จำนวนหนังสือสูงสุดที่ยืมได้ต่อคน
MAX_BORROW_BOOKS=3

# ค่าปรับต่อวัน (บาท)
FINE_PER_DAY=10

# -----------------------------------
# Session Settings
# -----------------------------------
# อายุ session (วินาที) - 3600 = 1 ชั่วโมง
SESSION_LIFETIME=3600

# -----------------------------------
# Timezone
# -----------------------------------
TIMEZONE=Asia/Bangkok

# -----------------------------------
# Debug Mode (ปิดใน Production!)
# -----------------------------------
APP_DEBUG=false

# -----------------------------------
# Rate Limits (ป้องกัน Brute Force)
# -----------------------------------
# จำนวนนาทีที่ต้องรอหลังจากใส่รหัสผิดเกินกำหนด (Default: 15)
RATE_LIMIT_WINDOW_MINUTES=15
# จำนวนครั้งที่ผิดได้สูงสุด (Default: 5)
# ⚠️ ยิ่งตัวเลขสูง ยิ่งเดารหัสผ่านได้ง่ายขึ้น — ไม่ควรเกิน 10
RATE_LIMIT_MAX_ATTEMPTS=5

# rate limit ของการค้นหา (แยกจากด้านบน — ผู้ใช้กดค้นหาบ่อยเป็นเรื่องปกติ)
# ⚠️ ห้องสมุดที่ออกเน็ตผ่าน IP เดียวจะแชร์โควตากันทั้งหมด ตั้งต่ำเกินไปจะใช้งานไม่ได้
SEARCH_RATE_LIMIT=300
SEARCH_RATE_WINDOW=5

# ===== Pagination =====
# จำนวนรายการต่อหน้า (ตารางแอดมิน / grid หน้าแรก)
ITEMS_PER_PAGE=20
BOOKS_PER_PAGE=12
