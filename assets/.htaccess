# ===================================
# assets/ — ไลบรารีภายนอกที่เก็บไว้ในเครื่อง (ดู assets/vendor/README.md)
# ===================================
# โฟลเดอร์นี้มีแต่ไฟล์นิ่ง (JS/CSS/ฟอนต์) ไม่มี PHP และไม่ควรมี

# 🛡️ ปิดการรัน PHP — ถ้ามีใครแอบวางไฟล์ .php ไว้ก็รันไม่ได้
php_flag engine off

<FilesMatch "\.(php|php5|phtml|phar)$">
    Require all denied
</FilesMatch>

# 📝 บอกชนิดไฟล์ฟอนต์ให้ Apache รู้
#    ไม่งั้นบาง server จะส่งมาโดยไม่มี Content-Type แล้วเบราว์เซอร์บางตัวไม่ยอมโหลด
<IfModule mod_mime.c>
    AddType font/woff2 .woff2
    AddType font/woff  .woff
    AddType text/css   .css
    AddType application/javascript .js
</IfModule>

# ⚡ ไฟล์พวกนี้ตรึงเวอร์ชันไว้แล้ว ไม่เปลี่ยนเอง → ให้เบราว์เซอร์เก็บ cache ยาว ๆ
#    ⚠️ ถ้าอัปเดตไลบรารี ต้องเปลี่ยนชื่อโฟลเดอร์หรือชื่อไฟล์ด้วย ไม่งั้นผู้ใช้จะได้ของเก่า
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/css               "access plus 1 year"
    ExpiresByType font/woff2             "access plus 1 year"
    ExpiresByType font/woff              "access plus 1 year"
</IfModule>
